{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-manifests.js",
    "dev": "next dev --experimental-https",
    "prebuild": "node scripts/copy-manifests.js",
    "build": "next build",
    "start": "next start",
    "start:dev": "next build && node server.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:prod": "knip --production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cartridge/connector": "0.13.12",
    "@cartridge/controller": "0.13.12",
    "@cartridge/presets": "^0.5.2",
    "@dojoengine/core": "^1.8.8",
    "@dojoengine/sdk": "^1.9.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@starknet-react/chains": "^5.0.3",
    "@starknet-react/core": "^5.0.3",
    "animejs": "4.4.1",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "starknet": "^8.9.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
