# Required — game state reads
TORII_URL=https://api.cartridge.gg/x/siege-sepolia/torii

# Required — Starknet RPC for signing/submitting transactions
RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
CHAIN_ID=SN_SEPOLIA

# Required — Dojo manifest path. Relative to mcp-server-2/, or absolute.
MANIFEST_PATH=../manifest_sepolia.json

# Optional — where the Cartridge session is persisted on disk.
# Defaults to .cartridge inside the working directory.
SESSION_DIR=.cartridge

# Optional — match-state poll interval, ms. Default 5000.
POLL_INTERVAL_MS=5000

# Optional — VRF provider override. Default is the canonical Cartridge VRF.
# VRF_PROVIDER_ADDRESS=0x051fea4450da9d6aee758bdeba88b2f665bcbf549d2c61421aa724e9ac0ced8f
