# Mainnet (SN_MAIN) — Cartridge headless session signing.
#
# To activate: copy this file to mcp-server-2/.env and reconnect the MCP
# server. The first write tool returns `not_ready` with a Cartridge auth URL —
# `open` the FULL URL (never copy wrapped terminal text) and approve within the
# 5-minute window from server launch. Approved session persists in SESSION_DIR.
#
# Signing mode: AGENT_ACCOUNT_ADDRESS / AGENT_PRIVATE_KEY are DELIBERATELY
# ABSENT here (not even commented). Their absence is what selects the Cartridge
# session flow in src/session.ts:90-98 — the agent signs AS the user's
# Controller via sponsored executeFromOutside. Setting either var would switch
# the server into raw-key mode (self-hosted katana only) and break mainnet.

# Required — game state reads (Torii, Task 6).
TORII_URL=https://siege-torii-mainnet-production.up.railway.app

# Required — Starknet RPC for signing/submitting transactions.
#
# Must be the CARTRIDGE mainnet RPC. On mainnet the write path is the Cartridge
# WASM SessionProvider (src/session.ts:65), which needs its own RPC/keychain to
# resolve the chain id and mint/submit sessions; a third-party v0.9 node would
# break session creation. RPC_URL also feeds the raw-fetch receipt poll
# (src/tools.ts:283), which is JSON-RPC-spec-agnostic and works here too.
# starknet.js RpcProvider is NOT on this path (it is gated behind the AGENT_*
# raw-key vars above), so the Task 5 starknet.js/spec-0.10.2 incompatibility
# does not apply to the MCP.
RPC_URL=https://api.cartridge.gg/x/starknet/mainnet
CHAIN_ID=SN_MAIN

# Required — Dojo manifest path. Relative to mcp-server-2/, or absolute.
MANIFEST_PATH=../manifest_mainnet.json

# Where the Cartridge session is persisted on disk. Distinct from the sepolia/
# katana .cartridge dir so approvals for different networks don't collide.
SESSION_DIR=.cartridge-mainnet

# Match-state poll interval, ms. NOTE: currently not read by src (the connect
# poll uses a hardcoded 3s in src/session.ts:53); kept for parity with .env.
POLL_INTERVAL_MS=5000

# Cartridge VRF provider (Task 1).
VRF_PROVIDER_ADDRESS=0x051fea4450da9d6aee758bdeba88b2f665bcbf549d2c61421aa724e9ac0ced8f

# Token deployments — mainnet (Task 5).
ABILITY_TOKEN_ADDRESS=0x583fb029535b4f18d267ea1462ffd7f3a785edcd873c4fd305f8d787e3ccbcc
IRON_TOKEN_ADDRESS=0x2be5138b0e987d3f84fe7850861a17b4a608a9f583c45c8d647486c304d8947
LINEN_TOKEN_ADDRESS=0x1df4ab0d418e43322f1134470a959d59da22cd7c5b03f9ba1ae375f271589c2
STONE_TOKEN_ADDRESS=0x4a1acd44fc316535f126ec06d7a60a0de356f6e3530c0940bd8c952c9949401
WOOD_TOKEN_ADDRESS=0x5fdb13ea34654956ca7fdda8da6d5ee3fb741d1c14ffe944d59e4288a7976c
EMBER_TOKEN_ADDRESS=0x1b784f80e5b87cbb6138954cd2016de77f7e641fe55c51baaa1c23908d35376
SEEDS_TOKEN_ADDRESS=0x4a6655dafd9505a9c96362475c6ad0f1744ba831c7503bf5b7d762f5f8613a7
